# Valori per la PRODUZIONE (docs/messa-online.md). In locale copia in .env.local e adatta.

# URL pubblico del sito (canonical, sitemap, Open Graph). Senza "/" finale.
NEXT_PUBLIC_SITE_URL=https://tecnolambro.it

# false = noindex globale e robots.txt chiuso. In produzione DEVE essere true, altrimenti Google non indicizza nulla.
NEXT_PUBLIC_ALLOW_INDEXING=false

# true = badge "Versione demo" e segnaposto evidenziati. Se manca vale true: in produzione impostala a false.
NEXT_PUBLIC_DEMO=true

# true (predefinito) = /es, /zh e /de in noindex e fuori da sitemap e hreflang, finché un madrelingua non le rivede.
NEXT_PUBLIC_NEW_LOCALES_NOINDEX=true

# Statistiche: Vercel Web Analytics si attiva da solo sui deploy Vercel (Vercel → Analytics → Enable).
# Plausible è facoltativo: lascialo vuoto (se lo attivi, aggiorna privacy e cookie policy).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Credito nel footer.
NEXT_PUBLIC_LIMITLESS_URL=https://www.limitlessmedia.it

# Redirect 308 al dominio da www, dal vecchio sito tecnolambro.com e da *.vercel.app (solo in produzione, vedi next.config.ts).
CANONICAL_REDIRECT=
REDIRECT_HOSTS=www.tecnolambro.it,tecnolambro.com,www.tecnolambro.com,tecnolambroooo.vercel.app

# ---- Richieste di preventivo (app/api/quote/route.ts). Solo lato server: niente NEXT_PUBLIC_.
# Casella che riceve le richieste.
QUOTE_TO_EMAIL=info@tecnolambro.it
# Facoltativa: copia nascosta di ogni richiesta.
QUOTE_BCC_EMAIL=
# Mittente. Con Resend deve essere un indirizzo del dominio verificato.
QUOTE_FROM_EMAIL=Tecnolambro <info@tecnolambro.it>
# 1) Resend (consigliato): chiave API da resend.com → API Keys.
RESEND_API_KEY=
# 2) In alternativa SMTP Aruba (usato solo se RESEND_API_KEY è vuota). Porta 465 = SSL.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@tecnolambro.it
SMTP_PASS=
# Facoltativo: la stessa richiesta in JSON al gestionale interno.
QUOTE_WEBHOOK_URL=
# Facoltativo: file oltre 4 MB in totale caricati su Vercel Blob (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=
# Solo in locale: 1 = nessuna email vera, le email finiscono in test-output/quote/. Ignorata in produzione.
QUOTE_TEST_MODE=
